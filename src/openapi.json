{
  "openapi": "3.1.0",
  "info": {
    "title": "Snapshot x402 API",
    "version": "1.0.0",
    "description": "Pay-per-request Snapshot (https://snapshot.box) governance data for agents: spaces, proposals with results, votes and voting power. No API key or account: call a /v1 route, get HTTP 402, and let an x402 (https://x402.org) client such as @x402/fetch with @x402/avm sign one entry of the PAYMENT-REQUIRED header (USDC on Algorand, or on Base when offered). It retries with PAYMENT-SIGNATURE, and the payment is settled only when the route succeeds. Each deployment sets its prices (default 0.01 USDC per read, 0.02 for /v1/vp); the live price is in x-x402.price on each operation and in the 402.",
    "license": { "name": "MIT", "identifier": "MIT" }
  },
  "servers": [{ "url": "/" }],
  "security": [{ "x402": [] }],
  "paths": {
    "/": {
      "get": {
        "operationId": "getIndex",
        "summary": "What this is and how to pay",
        "security": [],
        "responses": {
          "200": {
            "description": "HTML by default; JSON service info (routes, prices, payment details) when the request prefers application/json.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ServiceInfo" }
              },
              "text/html": {}
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "getOpenApi",
        "summary": "This OpenAPI document",
        "security": [],
        "responses": { "200": { "description": "OpenAPI 3.1 JSON." } }
      }
    },
    "/llms.txt": {
      "get": {
        "operationId": "getLlmsTxt",
        "summary": "Agent docs (llms.txt)",
        "security": [],
        "responses": { "200": { "description": "Plain text for agents." } }
      }
    },
    "/healthz": {
      "get": {
        "operationId": "getHealth",
        "summary": "Liveness",
        "security": [],
        "responses": { "200": { "description": "{\"status\": \"ok\"}" } }
      }
    },
    "/v1/spaces/{id}": {
      "get": {
        "operationId": "getSpace",
        "summary": "Space profile, settings and activity stats",
        "description": "One Snapshot space: identity, voting strategies, voting settings, admins, treasuries, delegation portal and activity counters.",
        "parameters": [{ "$ref": "#/components/parameters/SpaceId" }],
        "responses": {
          "200": {
            "description": "Paid data. The PAYMENT-RESPONSE header is the base64 settlement receipt with the transaction id.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Space" }
              }
            }
          },
          "402": { "$ref": "#/components/responses/PaymentRequired" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/spaces/{id}/proposals": {
      "get": {
        "operationId": "listSpaceProposals",
        "summary": "Proposals of a space, newest first",
        "description": "Proposals of one space, newest first, with state, choices, live or final scores, vote count and quorum. The body is not included; use GET /v1/proposals/{id}?include=body.",
        "parameters": [
          { "$ref": "#/components/parameters/SpaceId" },
          {
            "name": "state",
            "in": "query",
            "description": "Filter by state. Omit for all states.",
            "schema": { "enum": ["active", "pending", "closed"] }
          },
          {
            "name": "first",
            "in": "query",
            "description": "Page size.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          { "$ref": "#/components/parameters/Skip" }
        ],
        "responses": {
          "200": {
            "description": "Paid data. The PAYMENT-RESPONSE header is the base64 settlement receipt with the transaction id.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProposalList" }
              }
            }
          },
          "402": { "$ref": "#/components/responses/PaymentRequired" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/proposals/{id}": {
      "get": {
        "operationId": "getProposal",
        "summary": "Proposal with results",
        "description": "One proposal with per-choice results (score, share of total, score per strategy), the leading choice (null on a tie or with no score yet), quorum, strategies and state. Add include=body for the Markdown body.",
        "parameters": [
          { "$ref": "#/components/parameters/ProposalId" },
          {
            "name": "include",
            "in": "query",
            "description": "body adds the Markdown body.",
            "schema": { "type": "string", "enum": ["body"] }
          }
        ],
        "responses": {
          "200": {
            "description": "Paid data. The PAYMENT-RESPONSE header is the base64 settlement receipt with the transaction id.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Proposal" }
              }
            }
          },
          "402": { "$ref": "#/components/responses/PaymentRequired" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/proposals/{id}/votes": {
      "get": {
        "operationId": "listProposalVotes",
        "summary": "Votes on a proposal",
        "description": "Votes on one proposal, highest voting power (default) or newest first, with the proposal choices. choice is a 1-based index for single-choice and basic (choiceLabel gives its label, null for other types), an array of indexes for approval, ranked-choice and copeland, an object of index to weight for weighted and quadratic, or an encrypted string for shutter proposals until they close.",
        "parameters": [
          { "$ref": "#/components/parameters/ProposalId" },
          {
            "name": "first",
            "in": "query",
            "description": "Page size.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 100
            }
          },
          { "$ref": "#/components/parameters/Skip" },
          {
            "name": "orderBy",
            "in": "query",
            "description": "Sort key, always descending.",
            "schema": { "enum": ["vp", "created"], "default": "vp" }
          }
        ],
        "responses": {
          "200": {
            "description": "Paid data. The PAYMENT-RESPONSE header is the base64 settlement receipt with the transaction id.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/VoteList" }
              }
            }
          },
          "402": { "$ref": "#/components/responses/PaymentRequired" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/vp": {
      "get": {
        "operationId": "getVotingPower",
        "summary": "Voting power of an address",
        "description": "Voting power of one address per strategy: at the proposal's snapshot block with its strategies when proposal is given, otherwise at the latest block with the space's current strategies. Pass space or proposal; with both, the proposal must belong to the space.",
        "parameters": [
          {
            "name": "voter",
            "in": "query",
            "required": true,
            "description": "EVM (0x + 40 hex) or Starknet (0x + 64 hex) address.",
            "schema": {
              "type": "string",
              "pattern": "^0x([0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
            },
            "example": "0x3320756d61303284b8012a660ee185c58edd3bb7"
          },
          {
            "name": "space",
            "in": "query",
            "description": "Space id. Required without proposal.",
            "schema": { "$ref": "#/components/schemas/SpaceId" }
          },
          {
            "name": "proposal",
            "in": "query",
            "description": "Proposal id. Required without space.",
            "schema": { "$ref": "#/components/schemas/ProposalId" }
          }
        ],
        "responses": {
          "200": {
            "description": "Paid data. The PAYMENT-RESPONSE header is the base64 settlement receipt with the transaction id.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/VotingPower" }
              }
            }
          },
          "402": { "$ref": "#/components/responses/PaymentRequired" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "x402": {
        "type": "apiKey",
        "in": "header",
        "name": "PAYMENT-SIGNATURE",
        "description": "Base64 x402 v2 payment payload for one accepts[] entry of the PAYMENT-REQUIRED header."
      }
    },
    "parameters": {
      "SpaceId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Space id, case-insensitive.",
        "schema": { "$ref": "#/components/schemas/SpaceId" },
        "example": "ens.eth"
      },
      "ProposalId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Proposal id: 0x + 64 hex, or a legacy IPFS CID.",
        "schema": { "$ref": "#/components/schemas/ProposalId" },
        "example": "0xcd8d33f6531ed3baa3f728ca8509c66ce7505877b349e6127981e8254adf9a22"
      },
      "Skip": {
        "name": "skip",
        "in": "query",
        "description": "Offset for pagination, default 0.",
        "schema": { "type": "integer", "minimum": 0, "maximum": 5000 }
      }
    },
    "responses": {
      "PaymentRequired": {
        "description": "Payment required (error.code payment_required). The PAYMENT-REQUIRED header is base64 JSON {x402Version: 2, resource, accepts[]}, where each accepts entry is {scheme: exact, network, asset, amount (atomic units, 6 decimals), payTo, maxTimeoutSeconds, extra, for example feePayer and tag}: one for Algorand, plus one for Base when configured. Pay one and retry with PAYMENT-SIGNATURE. Also returned when a payment is rejected (payment_rejected, reason in the header error field, for example a reused payment) or not settled (settlement_failed; the data is withheld).",
        "headers": { "PAYMENT-REQUIRED": { "schema": { "type": "string" } } },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "Error": {
        "description": "Error, not charged.\n- 400 bad_request: bad input (checked after the payment is verified)\n- 404 not_found: unknown space or proposal\n- 405 method_not_allowed: only GET on /v1\n- 421 misdirected_request: wrong host; the message names the URL to use\n- 429 rate_limited: too many failed paid requests from this IP in a minute (Retry-After)\n- 500 internal_error\n- 502 upstream_error or facilitator_error: Snapshot or the facilitator failed; a facilitator error during settlement may still settle on chain\n- 503 upstream_rate_limited or facilitator_unavailable: Snapshot rate limit or facilitator down (Retry-After)\n- 504 upstream_timeout: Snapshot did not answer in time",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      }
    },
    "schemas": {
      "SpaceId": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^[^\\s/?#%\\\\]+\\.[^\\s/?#%\\\\]+$"
      },
      "ProposalId": {
        "type": "string",
        "pattern": "^(0x[0-9a-fA-F]{64}|Qm[1-9A-HJ-NP-Za-km-z]{44}|baf[a-z2-7]{56})$"
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" }
            }
          },
          "docs": { "type": "string", "description": "How to pay (402 only)." }
        }
      },
      "StrategyRef": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "network": { "type": ["string", "null"] },
          "symbol": { "type": ["string", "null"] }
        }
      },
      "Space": {
        "type": "object",
        "required": ["id", "name", "network", "strategies", "stats", "link"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": ["string", "null"] },
          "about": { "type": ["string", "null"] },
          "network": { "type": "string", "description": "Default chain id." },
          "symbol": { "type": ["string", "null"] },
          "avatar": { "type": ["string", "null"] },
          "website": { "type": ["string", "null"] },
          "twitter": { "type": ["string", "null"] },
          "github": { "type": ["string", "null"] },
          "coingecko": { "type": ["string", "null"] },
          "verified": { "type": "boolean" },
          "flagged": { "type": "boolean" },
          "hibernated": { "type": "boolean" },
          "turbo": { "type": "boolean" },
          "admins": { "type": "array", "items": { "type": "string" } },
          "moderators": { "type": "array", "items": { "type": "string" } },
          "membersCount": { "type": "integer" },
          "strategies": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/StrategyRef" }
          },
          "proposalValidation": { "type": ["string", "null"] },
          "voteValidation": { "type": ["string", "null"] },
          "voting": {
            "type": "object",
            "properties": {
              "delay": { "type": ["integer", "null"] },
              "period": { "type": ["integer", "null"] },
              "type": { "type": ["string", "null"] },
              "quorum": { "type": ["number", "null"] },
              "quorumType": { "type": ["string", "null"] },
              "blind": { "type": "boolean" },
              "privacy": { "type": ["string", "null"] }
            }
          },
          "stats": {
            "type": "object",
            "properties": {
              "activeProposals": { "type": "integer" },
              "proposals": { "type": "integer" },
              "proposals30d": { "type": "integer" },
              "followers": { "type": "integer" },
              "votes": { "type": "integer" },
              "votes7d": { "type": "integer" }
            }
          },
          "treasuries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": ["string", "null"] },
                "address": { "type": ["string", "null"] },
                "network": { "type": ["string", "null"] }
              }
            }
          },
          "delegationPortal": {
            "type": ["object", "null"],
            "properties": {
              "delegationType": { "type": "string" },
              "delegationContract": { "type": "string" },
              "delegationNetwork": { "type": "string" }
            }
          },
          "parent": { "type": ["string", "null"] },
          "children": { "type": "array", "items": { "type": "string" } },
          "created": { "type": "integer" },
          "link": { "type": "string", "format": "uri" }
        }
      },
      "ProposalSummary": {
        "type": "object",
        "required": ["id", "title", "state", "choices", "scores", "link"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "author": { "type": "string" },
          "state": { "enum": ["pending", "active", "closed"] },
          "type": { "type": ["string", "null"] },
          "privacy": { "type": ["string", "null"] },
          "created": { "type": "integer" },
          "start": { "type": "integer" },
          "end": { "type": "integer" },
          "snapshot": { "type": ["integer", "null"] },
          "choices": { "type": "array", "items": { "type": "string" } },
          "scores": { "type": "array", "items": { "type": "number" } },
          "scoresTotal": { "type": ["number", "null"] },
          "scoresState": { "enum": ["pending", "final", "invalid", null] },
          "votes": { "type": ["integer", "null"] },
          "quorum": { "type": ["number", "null"] },
          "quorumType": { "type": ["string", "null"] },
          "flagged": { "type": "boolean" },
          "link": { "type": "string", "format": "uri" }
        }
      },
      "ProposalList": {
        "type": "object",
        "required": [
          "space",
          "state",
          "first",
          "skip",
          "hasMore",
          "next",
          "items"
        ],
        "properties": {
          "space": { "type": "string" },
          "state": { "type": ["string", "null"] },
          "first": { "type": "integer" },
          "skip": { "type": "integer" },
          "hasMore": { "type": "boolean" },
          "next": { "type": ["string", "null"], "format": "uri-reference" },
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ProposalSummary" }
          }
        }
      },
      "ChoiceResult": {
        "type": "object",
        "required": ["choice", "label", "score", "share"],
        "properties": {
          "choice": { "type": "integer", "description": "1-based index." },
          "label": { "type": "string" },
          "score": { "type": "number" },
          "share": { "type": "number", "minimum": 0, "maximum": 1 },
          "scoreByStrategy": { "type": "array", "items": { "type": "number" } }
        }
      },
      "Proposal": {
        "type": "object",
        "required": [
          "id",
          "space",
          "title",
          "state",
          "choices",
          "results",
          "link"
        ],
        "properties": {
          "id": { "type": "string" },
          "ipfs": { "type": ["string", "null"] },
          "space": { "type": ["string", "null"], "description": "Space id." },
          "spaceName": { "type": ["string", "null"] },
          "spaceVerified": { "type": "boolean" },
          "title": { "type": "string" },
          "author": { "type": "string" },
          "state": { "enum": ["pending", "active", "closed"] },
          "type": { "type": ["string", "null"] },
          "privacy": { "type": ["string", "null"] },
          "created": { "type": "integer" },
          "updated": { "type": ["integer", "null"] },
          "start": { "type": "integer" },
          "end": { "type": "integer" },
          "snapshot": { "type": ["integer", "null"] },
          "network": { "type": "string" },
          "symbol": { "type": ["string", "null"] },
          "choices": { "type": "array", "items": { "type": "string" } },
          "labels": { "type": "array", "items": { "type": "string" } },
          "quorum": { "type": "number" },
          "quorumType": { "type": ["string", "null"] },
          "strategies": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/StrategyRef" }
          },
          "validation": { "type": ["string", "null"] },
          "results": {
            "type": "object",
            "required": ["scoresState", "scoresTotal", "choices"],
            "properties": {
              "scoresState": { "type": ["string", "null"] },
              "scoresTotal": { "type": "number" },
              "scoresUpdated": { "type": ["integer", "null"] },
              "votes": { "type": "integer" },
              "leading": { "type": ["integer", "null"] },
              "choices": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/ChoiceResult" }
              }
            }
          },
          "discussion": { "type": ["string", "null"] },
          "app": { "type": ["string", "null"] },
          "flagged": { "type": "boolean" },
          "link": { "type": "string", "format": "uri" },
          "body": { "type": "string", "description": "Only with include=body." }
        }
      },
      "Vote": {
        "type": "object",
        "required": ["id", "voter", "choice", "choiceLabel", "vp", "created"],
        "properties": {
          "id": { "type": "string" },
          "voter": { "type": "string" },
          "choice": {
            "description": "Index, array of indexes, object of index to weight, or an encrypted string (shutter, until close).",
            "oneOf": [
              { "type": "integer" },
              { "type": "array", "items": { "type": "integer" } },
              {
                "type": "object",
                "additionalProperties": { "type": "number" }
              },
              { "type": "string" }
            ]
          },
          "choiceLabel": { "type": ["string", "null"] },
          "vp": { "type": "number" },
          "vpByStrategy": { "type": "array", "items": { "type": "number" } },
          "vpState": { "type": ["string", "null"] },
          "created": { "type": "integer" },
          "reason": { "type": ["string", "null"] },
          "app": { "type": ["string", "null"] }
        }
      },
      "VoteList": {
        "type": "object",
        "required": [
          "proposal",
          "orderBy",
          "first",
          "skip",
          "total",
          "hasMore",
          "next",
          "items"
        ],
        "properties": {
          "proposal": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "space": { "type": ["string", "null"] },
              "state": { "type": "string" },
              "type": { "type": ["string", "null"] },
              "privacy": { "type": ["string", "null"] },
              "choices": { "type": "array", "items": { "type": "string" } }
            },
            "required": ["id", "space", "state", "type", "privacy", "choices"]
          },
          "orderBy": { "type": "string", "enum": ["vp", "created"] },
          "first": { "type": "integer" },
          "skip": { "type": "integer" },
          "total": { "type": "integer" },
          "hasMore": { "type": "boolean" },
          "next": { "type": ["string", "null"], "format": "uri-reference" },
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Vote" }
          }
        }
      },
      "VotingPower": {
        "type": "object",
        "required": [
          "voter",
          "space",
          "vp",
          "vpState",
          "vpByStrategy",
          "snapshot"
        ],
        "properties": {
          "voter": { "type": "string" },
          "space": { "type": "string" },
          "proposal": { "type": ["string", "null"] },
          "network": { "type": "string" },
          "snapshot": {
            "oneOf": [{ "type": "integer" }, { "const": "latest" }]
          },
          "vp": { "type": "number" },
          "vpState": { "type": "string", "enum": ["final", "pending"] },
          "vpByStrategy": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "vp"],
              "properties": {
                "name": { "type": "string" },
                "symbol": { "type": ["string", "null"] },
                "network": { "type": ["string", "null"] },
                "vp": { "type": "number" }
              }
            }
          }
        }
      },
      "ServiceInfo": {
        "type": "object",
        "required": [
          "name",
          "description",
          "version",
          "testnet",
          "payment",
          "routes",
          "free",
          "links"
        ],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "version": { "type": "string" },
          "testnet": { "type": "boolean" },
          "payment": {
            "type": "object",
            "required": [
              "protocol",
              "x402Version",
              "scheme",
              "network",
              "asset",
              "currency",
              "payTo",
              "facilitator",
              "howTo"
            ],
            "properties": {
              "protocol": { "const": "x402" },
              "x402Version": { "const": 2 },
              "scheme": { "const": "exact" },
              "network": { "type": "string" },
              "asset": { "type": "string" },
              "currency": { "const": "USDC" },
              "payTo": { "type": "string" },
              "facilitator": { "type": "string", "format": "uri" },
              "alternatives": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["network", "currency", "payTo"],
                  "properties": {
                    "network": { "type": "string" },
                    "currency": { "type": "string" },
                    "payTo": { "type": "string" }
                  }
                }
              },
              "howTo": { "type": "string" }
            }
          },
          "routes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["method", "path", "example", "price", "description"],
